# PostgreSQL
POSTGRES_DB="onlyturn"
POSTGRES_USER="onlyturn"
POSTGRES_PASSWORD="change-this-strong-postgres-password"
DATABASE_URL="postgresql://onlyturn:change-this-strong-postgres-password@db:5432/onlyturn?schema=public"

# Platform Hosts and Multi-Tenant Domains
PLATFORM_HOST="onlyturn.nanoapps.ar"
TENANT_BASE_DOMAIN="nanoapps.ar"
APP_BASE_URL="https://onlyturn.nanoapps.ar"
APP_BASE_DOMAIN="nanoapps.ar"

# Platform SuperAdmin Initial Bootstrap (used by scripts/bootstrap-platform.mjs)
ONLYTURN_SUPERADMIN_EMAIL="admin@nanolabs.com.ar"
ONLYTURN_SUPERADMIN_PASSWORD="change-this-superadmin-password-16chars"
ONLYTURN_SUPERADMIN_NAME="NanoLabs Admin"

# Secrets (Minimum 32 random characters each)
SESSION_SECRET="generate-a-long-random-production-secret-min32chars"
PAYMENT_ENCRYPTION_KEY="generate-a-long-random-payment-key-32chars"

# Security (Set to true in production behind HTTPS proxy)
COOKIE_SECURE="true"

# Cloudflare R2 Object Storage (Optional for MVP, required for image uploads)
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET="onlyturn-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://media.onlyturn.nanoapps.ar"
