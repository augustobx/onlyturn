# OnlyTurn · NanoLabs
# Copy as .env on the production host. Never commit the real values.

# PostgreSQL
POSTGRES_DB="onlyturn"
POSTGRES_USER="onlyturn"
POSTGRES_PASSWORD="CHANGE_WITH_A_STRONG_PASSWORD"

# Platform and tenant hosts
# Platform: https://onlyturn.nanoapps.ar
# Tenants:  https://<slug>.nanoapps.ar
# The central nanoapps-router decides which SaaS owns each tenant hostname.
PLATFORM_HOST="onlyturn.nanoapps.ar"
TENANT_BASE_DOMAIN="nanoapps.ar"
APP_BASE_URL="https://onlyturn.nanoapps.ar"
APP_BASE_DOMAIN="nanoapps.ar"
TZ="America/Argentina/Buenos_Aires"

# Next.js Server Actions
# Use one stable production key across rebuilds/instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="GENERATE_A_STRONG_STABLE_KEY"

# Internal automation worker and private iCal feeds
# Generate different stable random values for both.
AUTOMATION_CRON_SECRET="GENERATE_A_STRONG_RANDOM_SECRET"
CALENDAR_FEED_SECRET="GENERATE_A_DIFFERENT_STRONG_RANDOM_SECRET"

# Initial NanoLabs SuperAdmin bootstrap
# The bootstrap is idempotent and does not create demo tenants.
ONLYTURN_SUPERADMIN_EMAIL="admin@nanolabs.com.ar"
ONLYTURN_SUPERADMIN_PASSWORD="CHANGE_WITH_A_STRONG_SUPERADMIN_PASSWORD"
ONLYTURN_SUPERADMIN_NAME="NanoLabs Admin"

# Cookies
COOKIE_SECURE="true"

# Notifications · Email (Resend)
# Optional until an EMAIL automation is activated.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL=""

# Notifications · WhatsApp
# Recommended: point this to NanoLabs' own/provider webhook adapter.
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
# Direct Meta Graph fallback. Keep GRAPH_VERSION explicit and reviewed when Meta upgrades it.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION=""

# Mercado Pago credential encryption
# Required only if online payments/deposits are enabled.
# Minimum 32 characters.
PAYMENT_ENCRYPTION_KEY=""

# Cloudflare R2
# Optional until tenant image uploads are enabled.
R2_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET="onlyturn-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://media.onlyturn.nanoapps.ar"
